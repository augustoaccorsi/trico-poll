{
  "name": "trico-poll",
  "version": "1.0.0",
  "description": "WhatsApp poll bot for Grêmio match predictions",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:watch": "nodemon --exec \"tsx src/index.ts\"",
    "test:poll": "tsx src/test-poll.ts",
    "test:probabilities": "tsx src/test-probabilities.ts",
    "send-today": "tsx src/send-today.ts",
    "send-probabilities": "tsx src/send-probabilities.ts"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@whiskeysockets/baileys": "^6.7.21",
    "dotenv": "^16.4.5",
    "node-cron": "^4.2.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0"
  }
}
