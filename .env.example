FORZA_GREMIO_TEAM_ID=17474
FORZA_INTER_TEAM_ID=38885
# Groups that receive Grêmio polls (comma-separated)
# Run once without it set to see all groups and their JIDs logged on startup
WA_GREMIO_GROUP_JID=
# Groups that receive Internacional polls (comma-separated)
# Groups appearing in both vars receive polls for both teams
WA_INTER_GROUP_JID=
# Groups that receive World Cup polls (comma-separated)
WA_WC_GROUP_JID=
# Groups that receive Série A probability messages (comma-separated)
WA_PROBS_GROUP_JID=
# Used by test-poll workflow — send test polls to a separate group (comma-separated allowed)
WA_TEST_GROUP_JID=
# Used by send-hello workflow — group to send the good morning message
WA_HELLO_GROUP_JID=
# Tobias's WhatsApp JID for @mention (e.g. 5511999999999@s.whatsapp.net)
WA_HELLO_ID=
TZ_BRASILIA=America/Sao_Paulo
POLL_CRON_HOUR=5
LOG_LEVEL=info
