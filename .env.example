FORZA_TEAM_ID=17474
# Required: the exact group JID (e.g. 120363xxxxxx@g.us)
# Comma-separated for multiple groups: 120363aaa@g.us,120363bbb@g.us
# Run once without it set to see all groups and their JIDs logged on startup
WA_GROUP_JID=
# Used by test-poll workflow — send test polls to a separate group (comma-separated allowed)
WA_TEST_GROUP_JID=
# Used by send-hello workflow — group to send the good morning message
WA_HELLO_GROUP_JID=
# Tobias's WhatsApp JID for @mention (e.g. 5511999999999@s.whatsapp.net)
WA_HELLO_ID=
TZ_BRASILIA=America/Sao_Paulo
POLL_CRON_HOUR=5
LOG_LEVEL=info
